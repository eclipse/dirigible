<!DOCTYPE HTML>
<html lang="en" ng-app="perspective" ng-controller="PerspectiveController" xmlns="http://www.w3.org/1999/xhtml">

	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		<!-- Title directive that will automatically create a title based on the perspective config -->
		<title config-title></title>

		<!-- Fake icon -->
		<link rel="icon" sizes="any" href="data:;base64,iVBORw0KGgo=" />

		<!-- Perspective config: the perspective's extension module configs/${fileName}-perspective.json, read as the
		     'perspectiveData' global. Its order sorts the sidebar entries, its icon is the svg the sidebar shows. -->
		<script type="text/javascript" src="/services/platform/extensions/modules/${projectName}/configs/${fileName}-perspective.json?global=perspectiveData"></script>

		<!-- Base perspective services and styles -->
		<meta name="platform-links" category="ng-view,ng-perspective">

		<!-- Perspective controller -->
		<script type="text/javascript" src="js/${fileName}.js"></script>

	</head>

	<body>
		<!-- Layout -->
		<layout config="::layoutConfig"></layout>
		<!-- Theme support -->
		<theme></theme>
	</body>

</html>