                    if (${term.local}Matches.size() != 1) {
#if($lookup.deadLetter)
                        throw new IllegalStateException("Inbound ${name}: a message on [" + destination() + "]: element [" + index + "] of ["
                                + ${collection.fromLiteral} + "]: no unique ${lookup.targetEntity} matches " + ${lookup.keysExpression}
                                + " - no unique ${term.hopEntity} matches ${term.label} - dead-lettered");
#else
                        LOG.error("Inbound ${name}: a message on [{}]: element [{}] of [{}]: no unique ${lookup.targetEntity} matches {} - no unique ${term.hopEntity} matches ${term.label} - NOT ingested", destination(),
                                index, ${collection.fromLiteral}, ${lookup.keysExpression});
                        return;
#end
                    }
#end
#end
                    java.util.List<gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Entity> ${lookup.local}Matches =
                            new gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Repository()
                                    .findAll(Criteria.create()
#foreach($term in $lookup.terms)
                                                     .eq("${term.property}", ${term.valueExpression})#if(!$foreach.hasNext));#end
#end
                    if (${lookup.local}Matches.size() != 1) {
#if($lookup.deadLetter)
                        throw new IllegalStateException("Inbound ${name}: a message on [" + destination() + "]: element [" + index + "] of ["
