#end
#foreach($lookup in $collection.lookups)
#if($lookup.composite)
#foreach($term in $lookup.terms)
                Object ${term.local}Key = item.get(${term.fromLiteral});
                if (${term.local}Key == null) {
#if($lookup.deadLetter)
                    throw new IllegalStateException("Inbound ${name}: a message on [" + destination() + "]: element [" + index + "] of ["
                            + ${collection.fromLiteral} + "] carries no [" + ${term.fromLiteral} + "] to resolve ${lookup.property} by - dead-lettered");
#else
                    LOG.error("Inbound ${name}: a message on [{}]: element [{}] of [{}] carries no [{}] to resolve ${lookup.property} by - NOT ingested", destination(),
                            index, ${collection.fromLiteral}, ${term.fromLiteral});
                    return;
#end
                }
#end
                java.util.List<Object> ${lookup.local}Key = ${lookup.keyList};
                gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Entity ${lookup.local}Match =
                        ${lookup.local}Cache.get(${lookup.local}Key);
                if (${lookup.local}Match == null) {
#foreach($term in $lookup.terms)
#if($term.hop)
                    java.util.List<gen.${javaGenFolderName}.data.${term.javaHopPerspective}.${term.hopEntity}Entity> ${term.local}Matches =
                            new gen.${javaGenFolderName}.data.${term.javaHopPerspective}.${term.hopEntity}Repository()
