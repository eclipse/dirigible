            throw new IllegalStateException("Inbound ${name}: no unique ${lookup.targetEntity} matches " + ${lookup.keysExpression} + " from ["
                    + ${lookup.fromLiteral} + "] - no unique ${term.hopEntity} matches ${term.label} - dead-lettered");
#else
            LOG.error("Inbound ${name}: no unique ${lookup.targetEntity} matches {} from [{}] - no unique ${term.hopEntity} matches ${term.label} - NOT ingested",
                    ${lookup.keysExpression}, ${lookup.fromLiteral});
            return;
#end
        }
#end
#end
        java.util.List<gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Entity> ${lookup.local}Matches =
