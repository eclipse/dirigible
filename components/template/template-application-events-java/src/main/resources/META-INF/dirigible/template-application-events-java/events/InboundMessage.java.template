        if (${lookup.local}Matches.size() != 1) {
#if($lookup.deadLetter)
            throw new IllegalStateException("Inbound ${name}: no unique ${lookup.targetEntity} matches ${lookup.byProperty} [" + ${lookup.local}Key
                    + "] from [" + ${lookup.fromLiteral} + "] - dead-lettered");
#else
