#if($lookup.composite)
#foreach($term in $lookup.terms)
        Object ${term.local}Key = envelope.get(${term.fromLiteral});
        if (${term.local}Key == null) {
#if($lookup.deadLetter)
            throw new IllegalStateException("Inbound ${name}: a message on [" + destination() + "] carries no [" + ${term.fromLiteral}
                    + "] to resolve ${lookup.property} by - dead-lettered");
#else
            LOG.error("Inbound ${name}: a message on [{}] carries no [{}] to resolve ${lookup.property} by - NOT ingested", destination(),
